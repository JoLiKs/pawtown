	["cut.dream.2"] = "On a lonely hill a black cat with starry eyes is waiting.",
	["cut.dream.3"] = 'Midnight Cat: "Your spark got lost on Starfall night. Find your memories."',
	["cut.dream.4"] = "Chapter 1 complete. The story continues in the next update!",
}

return LocaleEn
]]></ProtectedString>
